{
  "name": "jobflow-api",
  "version": "0.1.0",
  "description": "Learning project: a concurrency-safe job-assignment API built with NestJS and PostgreSQL",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "node --env-file=.env node_modules/@nestjs/cli/bin/nest.js start --watch",
    "typeorm": "node --env-file=.env -r ts-node/register node_modules/typeorm/cli.js -d src/database/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run -t each",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:show": "npm run typeorm -- migration:show",
    "migration:create": "node -r ts-node/register node_modules/typeorm/cli.js migration:create",
    "migration:run:prod": "node node_modules/typeorm/cli.js -d dist/database/data-source.js migration:run -t each",
    "migration:check": "npm run typeorm -- migration:generate src/database/migrations/SchemaDrift --check",
    "user:create": "node --env-file=.env -r ts-node/register src/scripts/create-user.ts",
    "user:create:prod": "node dist/scripts/create-user.js",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config test/jest-e2e.config.js --runInBand",
    "seed:jobs": "node --env-file=.env -r ts-node/register src/scripts/seed-jobs.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.12",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.12",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.12",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/typeorm": "^11.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.12",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.7",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "~5.9"
  }
}
