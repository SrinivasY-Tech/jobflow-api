# Copy to .env for local development: cp .env.example .env
# Values here are local-dev placeholders, NOT real secrets.

NODE_ENV=development
PORT=3000

# Postgres connection used by the API and the TypeORM CLI.
# When running the API on your host machine, DB_HOST=localhost.
# Inside docker compose the api service overrides DB_HOST=postgres.
DB_HOST=localhost
DB_PORT=5432
DB_USER=jobflow
DB_PASSWORD=jobflow_dev_password
DB_NAME=jobflow

# Host port that docker compose publishes Postgres on (change if 5432 is taken).
DB_HOST_PORT=5432

# JWT signing secret (HS256), at least 32 characters. Generate your own, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-random-string-of-at-least-32-chars
# Access token lifetime in seconds (default 900 = 15 minutes)
JWT_EXPIRES_IN_SECONDS=900
