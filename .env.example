# Copy to .env for local development: cp .env.example .env
# Values here are local-dev placeholders, NOT real secrets.

NODE_ENV=development
PORT=3000

# Postgres connection used by the API and the TypeORM CLI.
# When running the API on your host machine, DB_HOST=localhost.
# Inside docker compose the api service overrides DB_HOST=postgres.
DB_HOST=localhost
DB_PORT=5432
DB_USER=jobflow
DB_PASSWORD=jobflow_dev_password
DB_NAME=jobflow

# Host port that docker compose publishes Postgres on (change if 5432 is taken).
DB_HOST_PORT=5432
